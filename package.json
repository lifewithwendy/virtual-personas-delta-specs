{
  "name": "vpds",
  "version": "0.1.0",
  "description": "One AI, four personas, delta specs and human gates: a lightweight alternative to multi-agent dev frameworks.",
  "keywords": [
    "ai",
    "agents",
    "spec-driven-development",
    "openspec",
    "claude-code",
    "cursor",
    "tdd",
    "obsidian"
  ],
  "homepage": "https://github.com/lifewithwendy/virtual-personas-delta-specs#readme",
  "bugs": {
    "url": "https://github.com/lifewithwendy/virtual-personas-delta-specs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifewithwendy/virtual-personas-delta-specs.git"
  },
  "license": "MIT",
  "author": "Wendt Edmund",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "vpds": "bin/vpds.mjs"
  },
  "files": [
    "bin/vpds.mjs",
    "bin/install.mjs",
    "vpds/personas/",
    "vpds/gate.mjs",
    "vpds/lib.mjs",
    "openspec/_templates/",
    "openspec/changes.base",
    "openspec/pipeline.canvas",
    "openspec/.obsidian/templates.json",
    "openspec/.obsidian/app.json",
    ".claude/commands/vp/",
    ".cursor/commands/vp-*.md",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --test \"vpds/*.test.mjs\" \"bin/*.test.mjs\"",
    "gate": "node vpds/gate.mjs"
  }
}
